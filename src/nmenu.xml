<?xml version="1.0"?>
<wf-panel-pi>
	<plugin name="panel">
	<_short>Panel</_short>
	<group>
	<_short>Searchable Menu</_short>
	<option name="nmenu_padding" type="int">
		<_short>Icon Horizontal Padding</_short>
		<default>6</default>
	</option>
	<option name="nmenu_show_tooltips" type="bool">
		<_short>Icon Menu Show Tooltips</_short>
		<default>false</default>
	</option>
	<option name="nmenu_alpha_sort" type="bool">
		<_short>Icon Menu Sort Alphabetically</_short>
		<default>true</default>
	</option>
	<option name="nmenu_hierarchic" type="bool">
		<_short>Icon Menu Hierarchic</_short>
		<default>true</default>
	</option>
	<option name="nmenu_overlay_col" type="string">
		<_short>Icon Menu Overlay Colour</_short>
		<default>""</default>
	</option>
	<option name="nmenu_overlay_text_col" type="string">
		<_short>Icon Menu Overlay Text Colour</_short>
		<default>""</default>
	</option>
	</group>
	</plugin>
</wf-panel-pi>
