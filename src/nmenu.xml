<?xml version="1.0"?>
<wf-panel-pi>
  <plugin name="nmenu">
	<group>
	  <option name="padding" type="int">
		<default>6</default>
	  </option>
	  <option name="show_tooltips" type="bool">
		<default>false</default>
	  </option>
	  <option name="alpha_sort" type="bool">
		<default>true</default>
	  </option>
	  <option name="hierarchic" type="bool">
		<default>false</default>
	  </option>
	  <option name="comp_icons" type="bool">
		<default>false</default>
	  </option>
	  <option name="overlay_col" type="string">
		<default>rgba(0,0,0,0)</default>
	  </option>
	  <option name="overlay_text_col" type="string">
		<default>rgb(0,0,0)</default>
	  </option>
	</group>
  </plugin>
</wf-panel-pi>
